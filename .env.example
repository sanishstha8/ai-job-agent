# Copy this file to ".env" and fill it in. Never share or commit .env.

# Required: get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: only used to pre-fill the login pages when you run `python main.py login <site>`.
# You can leave these empty and just type your details into the browser window instead.
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=
INDEED_EMAIL=
ZIPRECRUITER_EMAIL=
ZIPRECRUITER_PASSWORD=
